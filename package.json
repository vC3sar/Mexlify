{
  "name": "mexlify",
  "version": "1.0.0-alpha",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node tests/test_sync_server.js && node tests/test_sync_integration.js && node tests/test_discord_rich_presence.js && node tests/test_fullscreen_f11.js && node tests/test_obteniendo_badge.js && node APK_Player_Android/tests/test_android_player.js && node APK_Player_Android/tests/test_qr_sync.js && node APK_Player_Android/tests/test_lyrics_fallback.js"
  },
  "description": "Mexlify - Alpha",
  "author": "vC3sar",
  "license": "ISC",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "jsqr": "^1.4.0"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@phosphor-icons/web": "^2.1.2",
    "adm-zip": "^0.5.18",
    "colorthief": "^3.5.0",
    "discord-rpc": "^4.0.1",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "googleapis": "^164.1.0",
    "jquery": "^4.0.0",
    "mysql2": "^3.15.3",
    "path": "^0.12.7",
    "play-dl": "^1.9.7",
    "qrcode": "^1.5.4",
    "simple-notify": "^1.0.6",
    "sqlite3": "^6.0.1",
    "sweetalert2": "^11.26.25",
    "tough-cookie": "^5.1.2",
    "youtube-sr": "^4.3.12",
    "yt-dlp-exec": "^1.0.2"
  },
  "build": {
    "appId": "com.mexlify.electron",
    "productName": "Mexlify Alpha",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    }
  }
}
